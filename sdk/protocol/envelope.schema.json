{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dipinllx-source/macmini-app-bridge/sdk/protocol/envelope.schema.json",
  "title": "MMAB Adapter Protocol v1 envelope",
  "description": "Mirrors server/mmab-adapter-protocol Envelope / EnvelopeJson (contract-tested). payload is opaque text encoded by the profile codec (mmab-sv1 by default).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "profileId",
    "instanceId",
    "processGeneration",
    "connectionId",
    "leaseId",
    "fencingToken",
    "sequence",
    "messageKind",
    "deadline",
    "codecVersion",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "profileId": {
      "$ref": "#/$defs/id"
    },
    "instanceId": {
      "$ref": "#/$defs/id"
    },
    "processGeneration": {
      "$ref": "#/$defs/counter"
    },
    "connectionId": {
      "$ref": "#/$defs/id",
      "description": "Browser connection id (new on every reconnect); 'platform' for platform<->adapter control frames."
    },
    "leaseId": {
      "$ref": "#/$defs/id",
      "description": "Current exclusive lease; 'none' when no lease is active."
    },
    "fencingToken": {
      "$ref": "#/$defs/counter"
    },
    "streamId": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "sequence": {
      "$ref": "#/$defs/counter"
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "messageKind": {
      "enum": [
        "REQUEST",
        "RESPONSE",
        "EVENT",
        "PORT_OPEN",
        "PORT_TRANSFER",
        "PORT_DATA",
        "PORT_CLOSE",
        "PORT_ERROR",
        "HEARTBEAT",
        "CONTROL"
      ]
    },
    "operation": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9-]*)+$"
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "codecVersion": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "string",
      "description": "Opaque codec text. Frame budget (whole JSON text) is 1 MiB."
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "messageKind": {
            "enum": [
              "REQUEST",
              "RESPONSE"
            ]
          }
        }
      },
      "then": {
        "required": [
          "correlationId"
        ],
        "properties": {
          "correlationId": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "messageKind": {
            "enum": [
              "REQUEST",
              "CONTROL"
            ]
          }
        }
      },
      "then": {
        "required": [
          "operation"
        ]
      }
    },
    {
      "if": {
        "required": [
          "error"
        ]
      },
      "then": {
        "properties": {
          "messageKind": {
            "enum": [
              "RESPONSE",
              "CONTROL",
              "PORT_ERROR"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "errorCode": {
      "enum": [
        "COMPATIBILITY_BLOCKED",
        "PORT_OWNER_MISMATCH",
        "WAIT_CONFIRM",
        "LEASE_OCCUPIED",
        "STALE_GENERATION",
        "CODEC_UNSUPPORTED",
        "QUEUE_LIMIT",
        "INSPECTOR_CLEANUP_FAILED",
        "PROTOCOL_VERSION_UNSUPPORTED",
        "UNAUTHENTICATED",
        "ORIGIN_REJECTED",
        "UNKNOWN_OPERATION",
        "CAPABILITY_DISABLED",
        "DEADLINE_EXCEEDED",
        "BLOCKED_UPGRADE",
        "MALFORMED_FRAME",
        "LEASE_REQUIRED",
        "CSRF_REJECTED",
        "FETCH_SITE_REJECTED",
        "HOST_REJECTED",
        "TICKET_REJECTED",
        "REPLAY_REJECTED",
        "ADAPTER_UNAVAILABLE",
        "PORT_STATE",
        "RATE_LIMITED",
        "SETUP_REQUIRED",
        "NOT_FOUND",
        "METHOD_NOT_ALLOWED"
      ]
    }
  }
}
