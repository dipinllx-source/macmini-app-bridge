{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dipinllx-source/minimac-app-bridge/sdk/protocol/adapter.schema.json",
  "title": "MMAB adapter.yaml (protocol v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "displayName",
    "strategy",
    "protocol",
    "app",
    "permissions",
    "risk",
    "capabilities",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,32}$",
      "description": "Adapter package version; profileId = appId/version."
    },
    "strategy": {
      "enum": [
        "electron-main-inject",
        "electron-renderer-cdp",
        "local-web-proxy",
        "official-remote-api",
        "test-mock"
      ],
      "description": "test-mock is for offline tests only; the platform refuses it unless mmab.testing.allow-test-adapters=true."
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "max": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "executableAllowlist"
      ],
      "properties": {
        "bundleId": {
          "type": "string"
        },
        "executableAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "versionSource": {
          "enum": [
            "Info.plist",
            "package.json",
            "custom"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchArguments",
        "temporaryInspector",
        "persistentCdp",
        "fileUploadDir"
      ],
      "properties": {
        "launchArguments": {
          "type": "boolean"
        },
        "temporaryInspector": {
          "type": "boolean"
        },
        "persistentCdp": {
          "type": "boolean"
        },
        "fileUploadDir": {
          "type": "boolean"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui.render": {
          "$ref": "#/$defs/capabilityState"
        },
        "ui.history": {
          "$ref": "#/$defs/capabilityState"
        },
        "ui.compose": {
          "$ref": "#/$defs/capabilityState"
        },
        "stream.push": {
          "$ref": "#/$defs/capabilityState"
        },
        "file.upload": {
          "$ref": "#/$defs/capabilityState"
        },
        "file.drop": {
          "$ref": "#/$defs/capabilityState"
        },
        "clipboard.write": {
          "$ref": "#/$defs/capabilityState"
        },
        "clipboard.read": {
          "$ref": "#/$defs/capabilityState"
        },
        "media.voice": {
          "$ref": "#/$defs/capabilityState"
        },
        "app.git": {
          "$ref": "#/$defs/capabilityState"
        },
        "app.extension": {
          "$ref": "#/$defs/capabilityState"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "extract-from-app-bundle",
            "local-url",
            "adapter-bundled"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "operations": {
      "type": "object",
      "description": "Operation allowlist. Names must live in the adapter's namespace (appId without '-'); 'mmab.*' is reserved for the platform. Undeclared operations are rejected with UNKNOWN_OPERATION; operations whose capability is not SUPPORTED with CAPABILITY_DISABLED.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9-]*)+$",
        "maxLength": 64,
        "not": {
          "pattern": "^mmab\\."
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "kind"
        ],
        "properties": {
          "capability": {
            "enum": [
              "ui.render",
              "ui.history",
              "ui.compose",
              "stream.push",
              "file.upload",
              "file.drop",
              "clipboard.write",
              "clipboard.read",
              "media.voice",
              "app.git",
              "app.extension"
            ]
          },
          "kind": {
            "enum": [
              "request",
              "event"
            ]
          },
          "coalescible": {
            "type": "boolean",
            "description": "Events only: state notification that may be coalesced when the outbound queue is under pressure."
          }
        },
        "if": {
          "properties": {
            "coalescible": {
              "const": true
            }
          },
          "required": [
            "coalescible"
          ]
        },
        "then": {
          "properties": {
            "kind": {
              "const": "event"
            }
          }
        }
      }
    }
  },
  "description": "Descriptor of one adapter package (design §14.3). Java loader: instances/AdapterDescriptorLoader.",
  "$defs": {
    "capabilityState": {
      "enum": [
        "SUPPORTED",
        "UNVERIFIED",
        "DISABLED",
        "UNSUPPORTED"
      ]
    }
  }
}
