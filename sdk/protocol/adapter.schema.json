{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dipinllx-source/macmini-app-bridge/sdk/protocol/adapter.schema.json",
  "title": "MMAB adapter.yaml (protocol v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "appId",
    "displayName",
    "strategy",
    "protocol",
    "app",
    "permissions",
    "risk",
    "capabilities",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z.+-]{1,32}$",
      "description": "Adapter package version; profileId = appId/version."
    },
    "strategy": {
      "enum": [
        "electron-main-inject",
        "electron-renderer-cdp",
        "local-web-proxy",
        "official-remote-api",
        "test-mock"
      ],
      "description": "test-mock is for offline tests only; the platform refuses it unless mmab.testing.allow-test-adapters=true."
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "max": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "executableAllowlist"
      ],
      "properties": {
        "bundleId": {
          "type": "string"
        },
        "executableAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "versionSource": {
          "enum": [
            "Info.plist",
            "package.json",
            "custom"
          ]
        },
        "icon": {
          "type": "string",
          "pattern": "^Contents/Resources/[A-Za-z0-9._-]{1,64}\\.icns$",
          "description": "Optional app icon inside the bundle of the first executableAllowlist entry; rendered by the console (converted locally, never committed)."
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launchArguments",
        "temporaryInspector",
        "persistentCdp",
        "fileUploadDir"
      ],
      "properties": {
        "launchArguments": {
          "type": "boolean"
        },
        "temporaryInspector": {
          "type": "boolean"
        },
        "persistentCdp": {
          "type": "boolean"
        },
        "fileUploadDir": {
          "type": "boolean"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ui.render": {
          "$ref": "#/$defs/capabilityState"
        },
        "ui.history": {
          "$ref": "#/$defs/capabilityState"
        },
        "ui.compose": {
          "$ref": "#/$defs/capabilityState"
        },
        "stream.push": {
          "$ref": "#/$defs/capabilityState"
        },
        "file.upload": {
          "$ref": "#/$defs/capabilityState"
        },
        "file.drop": {
          "$ref": "#/$defs/capabilityState"
        },
        "file.pick": {
          "$ref": "#/$defs/capabilityState"
        },
        "clipboard.write": {
          "$ref": "#/$defs/capabilityState"
        },
        "clipboard.read": {
          "$ref": "#/$defs/capabilityState"
        },
        "media.voice": {
          "$ref": "#/$defs/capabilityState"
        },
        "app.git": {
          "$ref": "#/$defs/capabilityState"
        },
        "app.extension": {
          "$ref": "#/$defs/capabilityState"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "extract-from-app-bundle",
            "local-url",
            "adapter-bundled"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "operations": {
      "type": "object",
      "description": "Operation allowlist. Names must live in the adapter's namespace (appId without '-'); 'mmab.*' is reserved for the platform. Undeclared operations are rejected with UNKNOWN_OPERATION; operations whose capability is not enabled (see 'evidence') with CAPABILITY_DISABLED.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9-]*)+$",
        "maxLength": 64,
        "not": {
          "pattern": "^mmab\\."
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "kind"
        ],
        "properties": {
          "capability": {
            "enum": [
              "ui.render",
              "ui.history",
              "ui.compose",
              "stream.push",
              "file.upload",
              "file.drop",
              "file.pick",
              "clipboard.write",
              "clipboard.read",
              "media.voice",
              "app.git",
              "app.extension"
            ]
          },
          "kind": {
            "enum": [
              "request",
              "event"
            ]
          },
          "coalescible": {
            "type": "boolean",
            "description": "Events only: state notification that may be coalesced when the outbound queue is under pressure."
          },
          "sync": {
            "type": "boolean",
            "description": "Requests only (M3): may be called through the synchronous endpoint POST /__mmab/bridge/call (startup bootstrap, ipcRenderer.sendSync-style calls). Payloads must not carry MessagePorts."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coalescible": {
                  "const": true
                }
              },
              "required": [
                "coalescible"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "event"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "sync": {
                  "const": true
                }
              },
              "required": [
                "sync"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "request"
                }
              }
            }
          }
        ]
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inject"
      ],
      "description": "M3: classic scripts injected right after the first <head> of the original index page, in order. platform:<name> -> /__mmab/shim/<name> (sdk/web), adapter:<name> -> /__mmab/app-shim/<name> (the package's shim/ directory), resource:/<path>.js -> a path inside the instance resource root. Without this block the M1 module shim is injected.",
      "properties": {
        "inject": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^((platform|adapter):[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*\\.m?js|resource:(/[A-Za-z0-9_-][A-Za-z0-9._-]*)+\\.js)$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "M3 (ADR-0005): strongest evidence on the PLATFORM path per capability. When present, the gateway opens a SUPPORTED capability only with isolated-live/live evidence or an explicit operator verification grant (instance verify-capabilities). Absent = M1 semantics (SUPPORTED opens).",
      "properties": {
        "ui.render": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "ui.history": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "ui.compose": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "stream.push": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "file.upload": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "file.drop": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "file.pick": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "clipboard.write": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "clipboard.read": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "media.voice": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "app.git": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        },
        "app.extension": {
          "enum": [
            "offline",
            "isolated-live",
            "live"
          ]
        }
      }
    }
  },
  "description": "Descriptor of one adapter package (design §14.3). Java loader: instances/AdapterDescriptorLoader.",
  "$defs": {
    "capabilityState": {
      "enum": [
        "SUPPORTED",
        "UNVERIFIED",
        "DISABLED",
        "UNSUPPORTED"
      ]
    }
  }
}
