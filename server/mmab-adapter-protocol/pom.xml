<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.dipinllx</groupId>
    <artifactId>mmab-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>mmab-adapter-protocol</artifactId>
  <packaging>jar</packaging>
  <name>mmab-adapter-protocol</name>
  <description>MMAB Adapter Protocol v1: envelope, error codes, capability states, mmab-sv1 codec, adapter wire auth. Only depends on Jackson (tree model).</description>

  <dependencies>
    <!-- 只用树模型做严格解析；不做 POJO / 多态反序列化。版本由 Spring Boot BOM 管理。 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
